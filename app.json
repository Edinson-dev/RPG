{
  "expo": {
    "name": "RPG Match-3 & Cards",
    "slug": "rpg-match3-cards",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030008"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.rpgmatch3.cards",
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#030008"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rpgmatch3.cards"
    },
    "extra": {
      "eas": {}
    }
  }
}
